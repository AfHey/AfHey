// AfHey schema — the "Phase 1 migration boundary" of docs/product-spec.md §9
// (19 tables) plus the Phase 2 additions (decisions.md 2026-09-05 "Phase 2
// migration"): the four scheduler-constraint tables owned by UserSettings,
// Project.domain, and generated full-text search columns. No
// Conversation/Message/TurnReferenceSet or Proposal.conversation_id (Phase 3b).
//
// Rules the DB cannot express declaratively (deadline exactly-one-of,
// task_kind exactly-when fields, timed vs all-day exclusivity, single active
// WorkSession, ...) are enforced by CHECK constraints and partial unique
// indexes hand-added in the initial migration SQL, and mirrored by
// application-level validators. Cross-row rules (parent project kind, cycle
// prevention, block WorkSession/task agreement) are application-enforced.

generator client {
  provider = "prisma-client"
  output   = "../src/db/generated"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums (product-spec §9, §11)
// ---------------------------------------------------------------------------

enum CredentialKind {
  password
  passkey
}

enum ProjectKind {
  area
  project
}

enum ProjectStatus {
  active
  completed
  archived
}

enum Importance {
  low
  medium
  high
}

enum TaskStatus {
  open
  completed
  cancelled
}

enum TaskKind {
  action
  waiting_for
  reminder
}

enum TaskBucket {
  active
  backlog
  someday
}

enum DeadlineType {
  hard
  soft
}

enum UserPriority {
  must
  should
  could
}

enum EnergyLevel {
  low
  medium
  high
}

enum WorkType {
  deep
  shallow
  study
  communication
  errand
  other
}

enum Confidence {
  high
  medium
  needs_confirmation
}

enum EventKind {
  meeting
  appointment
  personal
  block
  other
}

enum ScheduleType {
  fixed
  flexible
}

enum BlockState {
  planned
  in_progress
  completed
  missed_unconfirmed
  cancelled
}

enum SyncStatus {
  local
  synced
  pending
  conflict
  error
}

enum CaptureSourceType {
  typed
  pasted
  dictated
}

enum CaptureProcessingStatus {
  received
  redacted
  proposed
  processed
  rejected
  failed
  no_ai
}

// Phase 2 (scheduler constraints; product-spec §7.1, §9.5)
enum ProjectDomain {
  work
  personal
}

enum AvailabilityKind {
  general
  job
}

enum WindowRecurrence {
  weekly
  once
}

enum JobTimePolicy {
  unavailable
  work_related_only
  any
}

enum ProposalOrigin {
  inbox
  scheduler
  afhey
  user
}

enum ProposalStatus {
  pending
  approved
  applying
  applied
  rejected
  expired
  conflicted
  failed
  superseded
  reverted
}

enum ApprovalPolicy {
  explicit
  tiered
}

enum OperationType {
  create
  update
  archive
  restore
  delete
}

// Phase 1 operation/reference entity types (spec §11.1, §14.1).
enum EntityType {
  task
  event
  note
  person
  project
}

// ---------------------------------------------------------------------------
// User, Credential, Session, UserSettings (spec §9.5, §10.9)
// ---------------------------------------------------------------------------

model User {
  id                       String   @id @default(dbgenerated("gen_random_uuid()")) @map("id") @db.Uuid
  sessionRevocationVersion Int      @default(1) @map("session_revocation_version")
  createdAt                DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  credentials Credential[]
  sessions    Session[]
  settings    UserSettings?

  @@map("app_user")
}

model Credential {
  id         String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String         @map("user_id") @db.Uuid
  kind       CredentialKind
  secretHash String?        @map("secret_hash")
  publicKey  Json?          @map("public_key")
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  lastUsedAt DateTime?      @map("last_used_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@map("credential")
}

model Session {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  tokenHash         String    @unique @map("token_hash")
  revocationVersion Int       @map("revocation_version")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt         DateTime  @map("expires_at") @db.Timestamptz(3)
  lastSeenAt        DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  revokedAt         DateTime? @map("revoked_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@map("session")
}

model UserSettings {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String   @unique @map("user_id") @db.Uuid
  revision        Int      @default(1)
  currentTimezone String   @default("America/New_York") @map("current_timezone")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  // Phase 2 scheduler constraints (product-spec §7.1; decisions.md 2026-09-05).
  availabilityWindows  AvailabilityWindow[]
  protectedWindows     ProtectedWindow[]
  preferredWindows     PreferredWindow[]
  schedulerPreferences SchedulerPreferences?

  @@map("user_settings")
}

// ---------------------------------------------------------------------------
// Project hierarchy (spec §6, §9.5)
// ---------------------------------------------------------------------------

model Project {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  revision    Int           @default(1)
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  archivedAt  DateTime?     @map("archived_at") @db.Timestamptz(3)
  aiExcluded  Boolean       @default(false) @map("ai_excluded")
  kind        ProjectKind
  status      ProjectStatus @default(active)
  name        String
  parentId    String?       @map("parent_id") @db.Uuid
  description String?
  importance  Importance?
  // Phase 2: areas only (CHECK in migration); "work" areas admit job time.
  domain      ProjectDomain?
  // Generated full-text column (Phase 2 search); maintained by PostgreSQL.
  searchVector Unsupported("tsvector")? @map("search_vector")

  parent   Project?  @relation("ProjectHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children Project[] @relation("ProjectHierarchy")
  tasks    Task[]
  events   Event[]
  notes    Note[]

  @@index([parentId])
  @@map("project")
}

// ---------------------------------------------------------------------------
// Task and its person links (spec §9.1)
// ---------------------------------------------------------------------------

model Task {
  id                       String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  revision                 Int           @default(1)
  createdAt                DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  archivedAt               DateTime?     @map("archived_at") @db.Timestamptz(3)
  aiExcluded               Boolean       @default(false) @map("ai_excluded")
  title                    String
  status                   TaskStatus    @default(open)
  taskKind                 TaskKind      @default(action) @map("task_kind")
  bucket                   TaskBucket    @default(active)
  description              String?
  notes                    String?
  location                 String?
  context                  String?
  projectId                String?       @map("project_id") @db.Uuid
  captureId                String?       @map("capture_id") @db.Uuid
  deadlineDate             DateTime?     @map("deadline_date") @db.Date
  deadlineAt               DateTime?     @map("deadline_at") @db.Timestamptz(3)
  deadlineTimezone         String?       @map("deadline_timezone")
  deadlineType             DeadlineType? @map("deadline_type")
  remindAt                 DateTime?     @map("remind_at") @db.Timestamptz(3)
  reminderTimezone         String?       @map("reminder_timezone")
  waitingForPersonId       String?       @map("waiting_for_person_id") @db.Uuid
  nudgeDate                DateTime?     @map("nudge_date") @db.Date
  estimatedDurationMinutes Int?          @map("estimated_duration_minutes")
  remainingEstimateMinutes Int?          @map("remaining_estimate_minutes")
  isSplittable             Boolean       @default(false) @map("is_splittable")
  isSchedulable            Boolean       @default(true) @map("is_schedulable")
  userPriority             UserPriority? @map("user_priority")
  computedPriorityScore    Int           @default(50) @map("computed_priority_score")
  energyLevel              EnergyLevel?  @map("energy_level")
  workType                 WorkType?     @map("work_type")
  earliestStartDate        DateTime?     @map("earliest_start_date") @db.Date
  preferredWindowStartTime DateTime?     @map("preferred_window_start_time") @db.Time(0)
  preferredWindowEndTime   DateTime?     @map("preferred_window_end_time") @db.Time(0)
  confidence               Confidence?
  completedAt              DateTime?     @map("completed_at") @db.Timestamptz(3)
  searchVector             Unsupported("tsvector")? @map("search_vector")

  project          Project?      @relation(fields: [projectId], references: [id], onDelete: Restrict)
  capture          Capture?      @relation(fields: [captureId], references: [id], onDelete: Restrict)
  waitingForPerson Person?       @relation("TaskWaitingForPerson", fields: [waitingForPersonId], references: [id], onDelete: Restrict)
  people           TaskPerson[]
  blocks           Event[]
  workSessions     WorkSession[]

  @@index([projectId])
  @@index([captureId])
  @@index([waitingForPersonId])
  @@index([status, bucket])
  @@map("task")
}

model TaskPerson {
  taskId    String   @map("task_id") @db.Uuid
  personId  String   @map("person_id") @db.Uuid
  role      String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  task   Task   @relation(fields: [taskId], references: [id], onDelete: Restrict)
  person Person @relation(fields: [personId], references: [id], onDelete: Restrict)

  @@id([taskId, personId])
  @@index([personId])
  @@map("task_person")
}

// ---------------------------------------------------------------------------
// Person and aliases (spec §6.1, §9.5)
// ---------------------------------------------------------------------------

model Person {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  revision      Int       @default(1)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  archivedAt    DateTime? @map("archived_at") @db.Timestamptz(3)
  aiExcluded    Boolean   @default(false) @map("ai_excluded")
  name          String
  role          String?
  lastContactAt DateTime? @map("last_contact_at") @db.Timestamptz(3)
  notes         String?

  aliases         PersonAlias[]
  taskLinks       TaskPerson[]
  eventLinks      EventPerson[]
  waitingForTasks Task[]        @relation("TaskWaitingForPerson")

  @@map("person")
}

model PersonAlias {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  revision        Int       @default(1)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  archivedAt      DateTime? @map("archived_at") @db.Timestamptz(3)
  aiExcluded      Boolean   @default(false) @map("ai_excluded")
  personId        String    @map("person_id") @db.Uuid
  alias           String
  normalizedAlias String    @unique @map("normalized_alias")

  person Person @relation(fields: [personId], references: [id], onDelete: Restrict)

  @@index([personId])
  @@map("person_alias")
}

// ---------------------------------------------------------------------------
// Event and its person links (spec §9.2)
// ---------------------------------------------------------------------------

model Event {
  id           String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  revision     Int          @default(1)
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  archivedAt   DateTime?    @map("archived_at") @db.Timestamptz(3)
  aiExcluded   Boolean      @default(false) @map("ai_excluded")
  title        String
  kind         EventKind
  scheduleType ScheduleType @map("schedule_type")
  blockState   BlockState?  @map("block_state")
  isLocked     Boolean      @default(false) @map("is_locked")
  startAt      DateTime?    @map("start_at") @db.Timestamptz(3)
  endAt        DateTime?    @map("end_at") @db.Timestamptz(3)
  allDayStartDate DateTime? @map("all_day_start_date") @db.Date
  allDayEndDate   DateTime? @map("all_day_end_date") @db.Date
  timezone     String
  taskId       String?      @map("task_id") @db.Uuid
  projectId    String?      @map("project_id") @db.Uuid
  captureId    String?      @map("capture_id") @db.Uuid
  description  String?
  location     String?
  notes        String?

  // Reserved sync provenance (spec §9.2); no synchronization before Phase 5.
  sourceProvider  String?    @map("source_provider")
  externalId      String?    @map("external_id")
  externalVersion String?    @map("external_version")
  lastSyncedAt    DateTime?  @map("last_synced_at") @db.Timestamptz(3)
  syncStatus      SyncStatus @default(local) @map("sync_status")
  searchVector    Unsupported("tsvector")? @map("search_vector")

  task         Task?         @relation(fields: [taskId], references: [id], onDelete: Restrict)
  project      Project?      @relation(fields: [projectId], references: [id], onDelete: Restrict)
  capture      Capture?      @relation(fields: [captureId], references: [id], onDelete: Restrict)
  people       EventPerson[]
  workSessions WorkSession[]

  @@index([taskId])
  @@index([projectId])
  @@index([captureId])
  @@index([startAt])
  @@map("event")
}

model EventPerson {
  eventId   String   @map("event_id") @db.Uuid
  personId  String   @map("person_id") @db.Uuid
  role      String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  event  Event  @relation(fields: [eventId], references: [id], onDelete: Restrict)
  person Person @relation(fields: [personId], references: [id], onDelete: Restrict)

  @@id([eventId, personId])
  @@index([personId])
  @@map("event_person")
}

// ---------------------------------------------------------------------------
// Note (spec §9.4)
// ---------------------------------------------------------------------------

model Note {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  revision   Int       @default(1)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(3)
  aiExcluded Boolean   @default(false) @map("ai_excluded")
  body       String
  title      String?
  projectId  String?   @map("project_id") @db.Uuid
  captureId  String?   @map("capture_id") @db.Uuid
  searchVector Unsupported("tsvector")? @map("search_vector")

  project Project? @relation(fields: [projectId], references: [id], onDelete: Restrict)
  capture Capture? @relation(fields: [captureId], references: [id], onDelete: Restrict)

  @@index([projectId])
  @@index([captureId])
  @@map("note")
}

// ---------------------------------------------------------------------------
// Capture (spec §9.5; `rejected` per decisions.md 2026-08-30)
// ---------------------------------------------------------------------------

model Capture {
  id               String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  revision         Int                     @default(1)
  createdAt        DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime                @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  rawText          String?                 @map("raw_text")
  redactedText     String?                 @map("redacted_text")
  sourceType       CaptureSourceType       @map("source_type")
  processingStatus CaptureProcessingStatus @default(received) @map("processing_status")
  aiExcluded       Boolean                 @default(false) @map("ai_excluded")
  rawDeleteAfter   DateTime?               @map("raw_delete_after") @db.Timestamptz(3)
  // Processing claim (decisions.md 2026-09-05, finding 2): held by exactly
  // one extraction attempt from before transmission until the Capture is
  // proposed or failed; no-AI and rejection refuse while it is held.
  processingClaimKey   String?   @unique @map("processing_claim_key")
  processingClaimedAt  DateTime? @map("processing_claimed_at") @db.Timestamptz(3)

  tasks     Task[]
  events    Event[]
  notes     Note[]
  proposals Proposal[]

  @@index([processingStatus])
  @@index([rawDeleteAfter])
  @@map("capture")
}

// ---------------------------------------------------------------------------
// Glossary (spec §9.5)
// ---------------------------------------------------------------------------

model GlossaryEntry {
  id             String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  revision       Int         @default(1)
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  archivedAt     DateTime?   @map("archived_at") @db.Timestamptz(3)
  aiExcluded     Boolean     @default(false) @map("ai_excluded")
  term           String
  normalizedTerm String      @unique @map("normalized_term")
  expandsTo      String      @map("expands_to")
  entityType     EntityType? @map("entity_type")
  // Loose reference by design: glossary may point at any Phase 1 entity type,
  // so this is a UUID value without a foreign key.
  entityId       String?     @map("entity_id") @db.Uuid

  @@map("glossary_entry")
}

// ---------------------------------------------------------------------------
// WorkSession (spec §9.3) — table ships in Phase 1, rows first written by the
// Phase 2 focus timer.
// ---------------------------------------------------------------------------

model WorkSession {
  id                      String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  revision                Int       @default(1)
  createdAt               DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  archivedAt              DateTime? @map("archived_at") @db.Timestamptz(3)
  aiExcluded              Boolean   @default(false) @map("ai_excluded")
  taskId                  String    @map("task_id") @db.Uuid
  eventId                 String?   @map("event_id") @db.Uuid
  startedAt               DateTime  @map("started_at") @db.Timestamptz(3)
  stoppedAt               DateTime? @map("stopped_at") @db.Timestamptz(3)
  adjustedDurationMinutes Int?      @map("adjusted_duration_minutes")
  adjustmentReason        String?   @map("adjustment_reason")
  notes                   String?

  task  Task   @relation(fields: [taskId], references: [id], onDelete: Restrict)
  event Event? @relation(fields: [eventId], references: [id], onDelete: Restrict)

  @@index([taskId])
  @@index([eventId])
  @@map("work_session")
}

// ---------------------------------------------------------------------------
// Proposal, ProposalOperation, ActionLog, FieldEvidence (spec §11, §9.5).
// Proposal.conversation_id is intentionally absent until Phase 3b.
// ---------------------------------------------------------------------------

model Proposal {
  id                   String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  revision             Int            @default(1)
  origin               ProposalOrigin
  status               ProposalStatus @default(pending)
  idempotencyKey       String         @unique @map("idempotency_key")
  approvalPolicy       ApprovalPolicy @default(explicit) @map("approval_policy")
  approvalTier         Int?           @map("approval_tier")
  createdAt            DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  expiresAt            DateTime?      @map("expires_at") @db.Timestamptz(3)
  captureId            String?        @map("capture_id") @db.Uuid
  supersedesProposalId String?        @map("supersedes_proposal_id") @db.Uuid
  undoesActionId       String?        @map("undoes_action_id") @db.Uuid
  approvedAt           DateTime?      @map("approved_at") @db.Timestamptz(3)
  appliedAt            DateTime?      @map("applied_at") @db.Timestamptz(3)
  failureReason        String?        @map("failure_reason")
  conflictDetails      Json?          @map("conflict_details")

  capture      Capture?            @relation(fields: [captureId], references: [id], onDelete: Restrict)
  supersedes   Proposal?           @relation("ProposalSupersedes", fields: [supersedesProposalId], references: [id], onDelete: Restrict)
  supersededBy Proposal[]          @relation("ProposalSupersedes")
  undoesAction ActionLog?          @relation("ProposalUndoesAction", fields: [undoesActionId], references: [id], onDelete: Restrict)
  operations   ProposalOperation[]
  actionLog    ActionLog?          @relation("ActionLogProposal")

  @@index([captureId])
  @@index([status])
  @@map("proposal")
}

model ProposalOperation {
  operationId           String        @id @default(dbgenerated("gen_random_uuid()")) @map("operation_id") @db.Uuid
  proposalId            String        @map("proposal_id") @db.Uuid
  sequence              Int
  dependsOnOperationIds String[]      @map("depends_on_operation_ids") @db.Uuid
  op                    OperationType
  entityType            EntityType    @map("entity_type")
  // Preallocated entity UUID (creates included) — referenced by value, no FK.
  entityId              String        @map("entity_id") @db.Uuid
  expectedRevision      Int?          @map("expected_revision")
  after                 Json?
  before                Json?
  reason                String?
  createdAt             DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  proposal      Proposal        @relation(fields: [proposalId], references: [id], onDelete: Restrict)
  fieldEvidence FieldEvidence[]

  @@unique([proposalId, sequence])
  @@index([entityId])
  @@map("proposal_operation")
}

model ActionLog {
  id              String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  proposalId      String         @unique @map("proposal_id") @db.Uuid
  origin          ProposalOrigin
  appliedAt       DateTime       @map("applied_at") @db.Timestamptz(3)
  // Ordered operation snapshots incl. before/after and pre/post revisions.
  // Entities are referenced by UUID value only (spec §9.5), so undo of a
  // create is never blocked by an audit foreign key.
  operations      Json
  idempotencyKey  String         @unique @map("idempotency_key")
  revertsActionId String?        @map("reverts_action_id") @db.Uuid
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  proposal         Proposal    @relation("ActionLogProposal", fields: [proposalId], references: [id], onDelete: Restrict)
  revertsAction    ActionLog?  @relation("ActionLogReverts", fields: [revertsActionId], references: [id], onDelete: Restrict)
  revertedBy       ActionLog[] @relation("ActionLogReverts")
  undoneByProposal Proposal[]  @relation("ProposalUndoesAction")

  @@map("action_log")
}

model FieldEvidence {
  id                  String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  proposalOperationId String     @map("proposal_operation_id") @db.Uuid
  fieldPath           String     @map("field_path")
  startOffset         Int        @map("start_offset")
  endOffset           Int        @map("end_offset")
  literalText         String?    @map("literal_text")
  confidence          Confidence
  resolverMeta        Json?      @map("resolver_meta")
  createdAt           DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)

  operation ProposalOperation @relation(fields: [proposalOperationId], references: [operationId], onDelete: Restrict)

  @@index([proposalOperationId])
  @@map("field_evidence")
}

// ---------------------------------------------------------------------------
// Phase 2 scheduler constraints (product-spec §7.1, §9.5; decisions.md
// 2026-09-05 "Phase 2 migration"). Child rows of UserSettings; versioned
// inputs to scheduler Proposals. Times are local wall-clock values in
// UserSettings.current_timezone; weekdays are ISO (1 = Monday … 7 = Sunday).
// CHECK constraints (start < end, weekday range, recurrence exactly-when,
// min <= max) are hand-added in the migration and mirrored in code.
// ---------------------------------------------------------------------------

model AvailabilityWindow {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userSettingsId String           @map("user_settings_id") @db.Uuid
